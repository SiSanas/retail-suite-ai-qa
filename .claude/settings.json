{
  "permissions": {
    "allow": [
      "mcp__playwright",
      "Read(config/**)",
      "Read(test-cases/**)",
      "Read(reports/**)",
      "Write(test-cases/**)",
      "Edit(test-cases/**)",
      "Write(reports/**)",
      "Edit(reports/**)",
      "Bash(date:*)",
      "Bash(mkdir:*)",
