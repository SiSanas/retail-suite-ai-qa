{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "@playwright/mcp@0.0.85",
        "--isolated",
        "--viewport-size=1440,900",
        "--output-dir=artifacts",
        "--secrets=config/secrets.env"
      ]
    }
  }
}
